# ────────────────────────────────────────────────────────────────
# PartFlow – variabili d'ambiente
# Copia questo file in .env e compila i valori prima di avviare
# ────────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=cambia_questo_valore_segreto
FLASK_APP=main.py
FLASK_ENV=development   # usa 'production' con Docker

# PostgreSQL (usato anche da compose.yaml)
POSTGRES_PASSWORD=secret
DATABASE_URL=postgresql://partflow:secret@localhost:5432/partflow

# Panthera ERP
PANTHERA_BASE_URL=https://tuo-server-panthera/api
PANTHERA_API_KEY=la_tua_api_key

# OCR: 'tesseract' (default, richiede Tesseract installato) oppure 'google_vision'
OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract          # percorso al binario, es. /usr/bin/tesseract

# Solo se OCR_ENGINE=google_vision
GOOGLE_VISION_API_KEY=
